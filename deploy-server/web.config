<?xml version="1.0" encoding="UTF-8"?>
<!-- Only needed if the server is Windows / IIS. Delete this file on Apache or cPanel hosting. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Canonical https non-www" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="off" />
            <add input="{HTTP_HOST}" pattern="^www\." />
          </conditions>
          <action type="Redirect" url="https://dumasgroup.co.za/{R:0}" redirectType="Permanent" />
        </rule>
        <rule name="sector-focus" stopProcessing="true"><match url="^sector-focus/?$" /><action type="Redirect" url="/our-companies/" redirectType="Permanent" /></rule>
        <rule name="commodities" stopProcessing="true"><match url="^commodities/?$" /><action type="Redirect" url="/our-companies/" redirectType="Permanent" /></rule>
        <rule name="projects" stopProcessing="true"><match url="^projects/?$" /><action type="Redirect" url="/" redirectType="Permanent" /></rule>
        <rule name="boffin" stopProcessing="true"><match url="^boffin/?$" /><action type="Redirect" url="/our-companies/#company-boffin" redirectType="Permanent" /></rule>
        <rule name="privacy-policy" stopProcessing="true"><match url="^privacy-policy/?$" /><action type="Redirect" url="/" redirectType="Permanent" /></rule>
        <rule name="cookie-policy-za" stopProcessing="true"><match url="^cookie-policy-za/?$" /><action type="Redirect" url="/" redirectType="Permanent" /></rule>
      </rules>
    </rewrite>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
  </system.webServer>
</configuration>
